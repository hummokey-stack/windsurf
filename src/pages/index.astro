---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { db, schema } from '../db';
import { eq, desc } from 'drizzle-orm';

// Fetch settings
const settingsList = await db.select().from(schema.settings).limit(1);
const siteSettings = settingsList[0] || { livraisonGratuiteMontant: 100 };
const livraisonSeuil = siteSettings.livraisonGratuiteMontant || 100;

// Parent categories
const allCategories = await db.select().from(schema.categories).where(eq(schema.categories.actif, 1));
const parentCategories = allCategories.filter((c) => c.parentId === null).sort((a, b) => (a.ordre || 0) - (b.ordre || 0));

// Nouveautés (active products marked as nouveauté or latest)
const nouveautes = await db
  .select()
  .from(schema.produits)
  .where(eq(schema.produits.estActif, 1))
  .orderBy(desc(schema.produits.dateCreation))
  .limit(4);

// Promotions
const promos = await db
  .select()
  .from(schema.produits)
  .where(eq(schema.produits.estActif, 1))
  .where(eq(schema.produits.estPromo, 1))
  .limit(4);

// Blog articles
const blogArticles = await db
  .select()
  .from(schema.blog)
  .where(eq(schema.blog.actif, 1))
  .orderBy(desc(schema.blog.dateCreation))
  .limit(3);

const catIcons: Record<string, string> = {
  wing: '🪂',
  surf: '🏄',
  foil: '⚡',
  kitesurf: '🪁',
  windsurf: '⛵',
  sup: '🏊',
  wakeboard: '🌊',
  efoil: '⚙️',
  neoprene: '🦺',
  lifestyle: '🕶️',
  snowboard: '🏔️',
};
---

<Layout title="Accueil">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-content">
        <span class="hero-tag">✦ Spécialiste sports de glisse</span>
        <h1>Votre passion,<br /><span>notre expertise.</span></h1>
        <p>Wingsurf, kitesurf, surf, foil, SUP… Découvrez notre sélection premium de matériel neuf et d'occasion.</p>
        <div class="hero-btns">
          <a href="/categorie/wing" class="btn btn-accent btn-lg">
            <i class="fas fa-wind"></i> Découvrir le Wing
          </a>
          <a href="/promotions" class="btn btn-outline" style="border-color:rgba(255,255,255,0.5);color:#fff;">
            🔥 Voir les promos
          </a>
        </div>
        <div class="hero-stats">
          <div>
            <div class="hero-stat-num">500+</div>
            <div class="hero-stat-label">Produits en stock</div>
          </div>
          <div>
            <div class="hero-stat-num">20+</div>
            <div class="hero-stat-label">Marques premium</div>
          </div>
          <div>
            <div class="hero-stat-num">10 ans</div>
            <div class="hero-stat-label">D'expérience</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bandeau livraison -->
  <div class="bandeau-livraison">
    <span><span class="icon">🚚</span>Livraison offerte dès {livraisonSeuil} €</span>
    <span><span class="icon">🔄</span>Retours 30 jours</span>
    <span><span class="icon">🔒</span>Paiement sécurisé</span>
    <span><span class="icon">💬</span>Experts disponibles</span>
  </div>

  <!-- Univers / Catégories -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Nos univers</h2>
        <div class="underline"></div>
        <p>11 disciplines, une passion commune : la glisse</p>
      </div>
      <div class="categories-grid">
        {parentCategories.map((cat) => (
          <a href={`/categorie/${cat.slug}`} class="category-card">
            <span class="icon">{catIcons[cat.slug] || '🌊'}</span>
            <div class="name">{cat.nom}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Nouveautés -->
  {nouveautes.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>⭐ Nouveautés</h2>
          <div class="underline"></div>
          <p>Les dernières références arrivées en boutique</p>
        </div>
        <div class="products-grid">
          {nouveautes.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
        <div class="text-center mt-4">
          <a href="/categorie/wing" class="btn btn-outline">Voir tous les produits</a>
        </div>
      </div>
    </section>
  )}

  <!-- Promotions -->
  {promos.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <h2>🔥 Promotions</h2>
          <div class="underline"></div>
          <p>Des prix réduits sur du matériel premium</p>
        </div>
        <div class="products-grid">
          {promos.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
        <div class="text-center mt-4">
          <a href="/promotions" class="btn btn-accent">🔥 Toutes les promos</a>
        </div>
      </div>
    </section>
  )}

  <!-- Notre expertise -->
  <section class="section">
    <div class="container">
      <div class="expertise-layout">
        <div class="expertise-img">
          <img src="/assets/images/placeholder.jpg" alt="Équipe GlisseShop" style="filter:hue-rotate(180deg);" />
        </div>
        <div class="expertise-text">
          <h2>10 ans au service de votre passion</h2>
          <p>Fondée par des passionnés de sports nautiques, GlisseShop est votre partenaire de confiance pour tous vos équipements de glisse. Notre équipe de riders experts vous conseille sur le matériel adapté à votre niveau et à vos conditions de ride.</p>
          <p>Showroom ouvert 7j/7, essais possibles, location de matériel, cours d'initiation… Tout pour vivre la glisse à 100% !</p>
          <div class="expertise-points">
            <div class="expertise-point">
              <div class="dot"></div>
              <span>Conseils personnalisés par des riders professionnels</span>
            </div>
            <div class="expertise-point">
              <div class="dot"></div>
              <span>Matériel d'occasion certifié et contrôlé</span>
            </div>
            <div class="expertise-point">
              <div class="dot"></div>
              <span>Service après-vente rapide et réparations</span>
            </div>
            <div class="expertise-point">
              <div class="dot"></div>
              <span>Partenaire officiel des plus grandes marques</span>
            </div>
          </div>
          <div class="mt-3">
            <a href="/a-propos" class="btn btn-primary">En savoir plus <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  {blogArticles.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <h2>Blog & Conseils</h2>
          <div class="underline"></div>
          <p>Guides, spots, entretien et actus sports de glisse</p>
        </div>
        <div class="blog-grid">
          {blogArticles.map((art) => (
            <article class="blog-card">
              <div class="blog-card-img">
                <img src={art.image || '/assets/images/placeholder.jpg'} alt={art.titre} />
              </div>
              <div class="blog-card-body">
                {art.categorie && <span class="blog-cat-tag">{art.categorie}</span>}
                <h3 class="blog-card-title">
                  <a href={`/blog/${art.slug}`}>{art.titre}</a>
                </h3>
                <p class="blog-card-excerpt">
                  {(art.extrait || art.contenu || '').substring(0, 120)}…
                </p>
                <div class="blog-card-meta">
                  <span><i class="fas fa-calendar" style="margin-right:4px;"></i>{art.dateCreation ? art.dateCreation.substring(0, 10) : ''}</span>
                  <a href={`/blog/${art.slug}`} style="color:var(--primary);font-weight:600;font-size:0.82rem;">
                    Lire <i class="fas fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="text-center mt-4">
          <a href="/blog" class="btn btn-outline">Tous les articles <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </section>
  )}
</Layout>
