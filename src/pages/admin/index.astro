---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, schema } from '../../db';
import { eq, sql, desc, lte, gt, and } from 'drizzle-orm';
import { formatPrix } from '../../lib/utils';

// Helper for status badge
function labelStatut(statut: string) {
  switch (statut) {
    case 'confirmee':
      return { label: 'Confirmée', class: 'badge-info' };
    case 'expediee':
      return { label: 'Expédiée', class: 'badge-primary' };
    case 'livree':
      return { label: 'Livrée', class: 'badge-success' };
    case 'annulee':
      return { label: 'Annulée', class: 'badge-danger' };
    case 'en_attente':
    default:
      return { label: 'En attente', class: 'badge-warning' };
  }
}

function formatDate(dateStr?: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

// Queries
const activeProducts = await db.select({ count: sql<number>`count(*)` }).from(schema.produits).where(eq(schema.produits.estActif, 1));
const totalProducts = activeProducts[0]?.count || 0;

const totalOrdersRes = await db.select({ count: sql<number>`count(*)` }).from(schema.commandes);
const totalOrders = totalOrdersRes[0]?.count || 0;

const pendingOrdersRes = await db.select({ count: sql<number>`count(*)` }).from(schema.commandes).where(eq(schema.commandes.statut, 'en_attente'));
const pendingOrdersCount = pendingOrdersRes[0]?.count || 0;

const currentMonthStr = new Date().toISOString().substring(0, 7); // YYYY-MM
const revenueRes = await db.select({ total: sql<number>`sum(${schema.commandes.total})` }).from(schema.commandes)
  .where(sql`substr(${schema.commandes.dateCommande}, 1, 7) = ${currentMonthStr} AND ${schema.commandes.statut} != 'annulee'`);
const revenueMonth = revenueRes[0]?.total || 0;

const blogRes = await db.select({ count: sql<number>`count(*)` }).from(schema.blog).where(eq(schema.blog.actif, 1));
const totalBlogPosts = blogRes[0]?.count || 0;

// Recent orders
const lastOrders = await db.select().from(schema.commandes).orderBy(desc(schema.commandes.dateCommande)).limit(8);

// Low stock / Stock out
const stockOut = await db.select().from(schema.produits).where(and(eq(schema.produits.estActif, 1), eq(schema.produits.stock, 0))).limit(5);
const lowStock = await db.select().from(schema.produits).where(and(eq(schema.produits.estActif, 1), gt(schema.produits.stock, 0), lte(schema.produits.stock, 3))).limit(5);
---

<AdminLayout title="Dashboard">
  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fas fa-box"></i></div>
      <div>
        <div class="stat-num">{totalProducts}</div>
        <div class="stat-label">Produits actifs</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon orange"><i class="fas fa-shopping-bag"></i></div>
      <div>
        <div class="stat-num">{totalOrders}</div>
        <div class="stat-label">Commandes totales</div>
        {pendingOrdersCount > 0 && (
          <div class="stat-change up"><i class="fas fa-clock"></i> {pendingOrdersCount} en attente</div>
        )}
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green"><i class="fas fa-euro-sign"></i></div>
      <div>
        <div class="stat-num">{formatPrix(revenueMonth)}</div>
        <div class="stat-label">CA ce mois</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon purple"><i class="fas fa-newspaper"></i></div>
      <div>
        <div class="stat-num">{totalBlogPosts}</div>
        <div class="stat-label">Articles publiés</div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="quick-links">
    <a href="/admin/produits/nouveau" class="quick-link"><span class="icon">➕</span> Nouveau produit</a>
    <a href="/admin/commandes" class="quick-link"><span class="icon">📦</span> Gérer commandes {pendingOrdersCount > 0 && <span class="badge-admin badge-danger">{pendingOrdersCount}</span>}</a>
    <a href="/admin/blog/nouveau" class="quick-link"><span class="icon">✍️</span> Écrire un article</a>
    <a href="/admin/parametres" class="quick-link"><span class="icon">⚙️</span> Paramètres</a>
    <a href="/admin/categories" class="quick-link"><span class="icon">🏷️</span> Catégories</a>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

    <!-- Dernières commandes -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-shopping-bag" style="margin-right:8px;color:var(--admin-primary);"></i>Dernières commandes</h3>
        <a href="/admin/commandes" class="btn-admin btn-admin-outline btn-admin-sm">Tout voir</a>
      </div>
      <div style="overflow-x:auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Réf.</th>
              <th>Client</th>
              <th>Total</th>
              <th>Statut</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {lastOrders.length === 0 ? (
              <tr><td colspan="5" style="text-align:center;color:#aaa;padding:30px;">Aucune commande</td></tr>
            ) : (
              lastOrders.map((cmd) => {
                const s = labelStatut(cmd.statut || '');
                return (
                  <tr>
                    <td><strong>{cmd.reference}</strong></td>
                    <td>{cmd.clientNom}</td>
                    <td><strong>{formatPrix(cmd.total)}</strong></td>
                    <td><span class={`badge-admin ${s.class}`}>{s.label}</span></td>
                    <td style="color:#999;font-size:0.8rem;">{formatDate(cmd.dateCommande)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Alertes stock -->
    <div style="display:flex;flex-direction:column;gap:24px;">

      {stockOut.length > 0 && (
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-exclamation-triangle" style="margin-right:8px;color:var(--admin-danger);"></i>Ruptures de stock</h3>
            <a href="/admin/produits" class="btn-admin btn-admin-outline btn-admin-sm">Gérer</a>
          </div>
          <div style="overflow-x:auto;">
            <table class="admin-table">
              <thead><tr><th>Produit</th><th>Marque</th><th>Action</th></tr></thead>
              <tbody>
                {stockOut.map((p) => (
                  <tr>
                    <td>{p.nom}</td>
                    <td><span class="badge-admin badge-secondary">{p.marque || 'N/A'}</span></td>
                    <td><a href={`/admin/produits/${p.id}`} class="btn-admin btn-admin-sm btn-admin-warning"><i class="fas fa-edit"></i></a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {lowStock.length > 0 && (
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-battery-quarter" style="margin-right:8px;color:var(--admin-warning);"></i>Stock faible (≤3)</h3>
          </div>
          <div style="overflow-x:auto;">
            <table class="admin-table">
              <thead><tr><th>Produit</th><th>Stock</th><th>Action</th></tr></thead>
              <tbody>
                {lowStock.map((p) => (
                  <tr>
                    <td>{p.nom}</td>
                    <td><span class="badge-admin badge-warning">{p.stock} restant(s)</span></td>
                    <td><a href={`/admin/produits/${p.id}`} class="btn-admin btn-admin-sm btn-admin-outline"><i class="fas fa-edit"></i></a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {stockOut.length === 0 && lowStock.length === 0 && (
        <div class="card" style="text-align:center;padding:40px;color:#888;">
          <div style="font-size:2rem;margin-bottom:10px;">✅</div>
          <h3>Stocks sous contrôle</h3>
          <p style="font-size:0.9rem;margin-top:4px;">Aucun produit n'est actuellement en rupture ou en stock critique.</p>
        </div>
      )}

    </div>

  </div>
</AdminLayout>
