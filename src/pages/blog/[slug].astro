---
import Layout from '../../layouts/Layout.astro';
import { db, schema } from '../../db';
import { eq, ne, desc, and } from 'drizzle-orm';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const articleRes = await db.select().from(schema.blog).where(eq(schema.blog.slug, slug)).limit(1);
if (articleRes.length === 0 || articleRes[0].actif === 0) {
  return Astro.redirect('/blog');
}

const article = articleRes[0];

const recents = await db
  .select()
  .from(schema.blog)
  .where(and(eq(schema.blog.actif, 1), ne(schema.blog.slug, slug)))
  .orderBy(desc(schema.blog.dateCreation))
  .limit(3);
---

<Layout title={article.titre} description={article.extrait || ''}>
  <div class="page-hero" style="padding:50px 0 30px;">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Accueil</a><span>›</span>
        <a href="/blog">Blog</a><span>›</span>
        {article.categorie && (
          <>
            <a href={`/blog?cat=${encodeURIComponent(article.categorie)}`}>{article.categorie}</a><span>›</span>
          </>
        )}
        <span>{article.titre.substring(0, 40)}…</span>
      </nav>
      {article.categorie && <span class="hero-tag" style="margin-bottom:14px;">{article.categorie}</span>}
      <h1 style="font-size:clamp(1.8rem,4vw,3rem);max-width:800px;">{article.titre}</h1>
      <div class="article-meta" style="margin-top:12px;display:flex;gap:16px;color:rgba(255,255,255,0.8);font-size:0.9rem;">
        <span><i class="fas fa-calendar" style="margin-right:4px;"></i>{article.dateCreation ? article.dateCreation.substring(0, 10) : ''}</span>
        <span><i class="fas fa-tag" style="margin-right:4px;"></i>{article.categorie || 'Blog'}</span>
      </div>
    </div>
  </div>

  <div class="container" style="padding:40px 0 60px;">
    <div style="display:grid;grid-template-columns:1fr 300px;gap:50px;align-items:start;">

      <!-- Article -->
      <article>
        {article.image && (
          <img
            src={article.image}
            alt={article.titre}
            style="width:100%;max-height:420px;object-fit:cover;border-radius:12px;margin-bottom:30px;"
          />
        )}

        <div class="article-content" set:html={article.contenu || ''} />

        <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--gray-light);">
          <p style="font-weight:700;margin-bottom:12px;font-family:Rajdhani,sans-serif;">Partager cet article :</p>
          <div style="display:flex;gap:10px;">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.request.url)}`} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
              <i class="fab fa-facebook-f"></i> Facebook
            </a>
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.request.url)}&text=${encodeURIComponent(article.titre)}`} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
              <i class="fab fa-x-twitter"></i> X / Twitter
            </a>
          </div>
        </div>

        <div style="margin-top:32px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;">
          <a href="/blog" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Tous les articles</a>
        </div>
      </article>

      <!-- Sidebar -->
      <aside>
        <div style="background:var(--light);border-radius:12px;padding:22px;">
          <h3 style="font-family:Rajdhani,sans-serif;font-size:1.1rem;margin-bottom:16px;">Articles récents</h3>
          {recents.map((r) => (
            <div style="margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid #ddd;display:flex;gap:12px;">
              <img
                src={r.image || '/assets/images/placeholder.jpg'}
                style="width:60px;height:60px;object-fit:cover;border-radius:8px;flex-shrink:0;"
                alt={r.titre}
              />
              <div>
                <a href={`/blog/${r.slug}`} style="font-size:0.88rem;font-weight:700;color:var(--dark);line-height:1.3;display:block;">
                  {r.titre.substring(0, 55)}
                </a>
                <span style="font-size:0.76rem;color:#aaa;">{r.dateCreation ? r.dateCreation.substring(0, 10) : ''}</span>
              </div>
            </div>
          ))}
        </div>

        <div style="background:linear-gradient(135deg,var(--primary),var(--secondary));border-radius:12px;padding:24px;margin-top:20px;color:white;text-align:center;">
          <div style="font-size:2rem;margin-bottom:10px;">🏄</div>
          <h3 style="font-family:Rajdhani,sans-serif;font-size:1.2rem;margin-bottom:10px;">Équipez-vous !</h3>
          <p style="font-size:0.85rem;opacity:0.9;margin-bottom:16px;">Découvrez notre sélection de matériel de wingsurf.</p>
          <a href="/categorie/wing" class="btn btn-white btn-sm" style="background:#fff;color:var(--dark);padding:8px 16px;border-radius:6px;font-weight:600;">Voir les produits</a>
        </div>
      </aside>

    </div>
  </div>
</Layout>
